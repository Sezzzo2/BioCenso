# Copia este archivo como .env y completa los valores. Nunca subas el .env a git.

PORT=4000
NODE_ENV=development

# --- Base de datos ---
# En la nube basta con DATABASE_URL (Railway la crea al agregar PostgreSQL).
# DATABASE_URL=postgresql://usuario:clave@host:5432/railway
# DB_SSL=true   # solo si te conectas por la URL pública de la base
DB_HOST=localhost
DB_PORT=5432
DB_NAME=biocenso
DB_NAME_TEST=biocenso_test
DB_USER=postgres
DB_PASSWORD=

# --- Cloudinary (fotos de los bovinos) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Autenticación ---
# En producción: mínimo 32 caracteres aleatorios.
JWT_SECRET=
JWT_EXPIRES_IN=2h

# --- Red ---
# Orígenes permitidos por CORS, separados por comas.
# Producción: https://biocenso-ucc-2026.web.app,https://biocenso-ucc-2026.firebaseapp.com
FRONTEND_ORIGIN=http://localhost:5173
# true detrás de un proxy (Railway, Render): el límite de peticiones usa la IP real
TRUST_PROXY=false

# --- Servicio de IA ---
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=170000
