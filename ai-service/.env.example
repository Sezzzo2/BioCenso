# Variables del servicio de IA. En la nube se configuran en el panel (Render o Railway), no en el código.
GEMINI_API_KEY=
# Token compartido con el backend: /predict rechaza peticiones sin él
AI_SERVICE_TOKEN=
# Opcional: modelo que se prueba primero; si falla se usan los de respaldo
# GEMINI_MODEL=gemini-3.8-flash
